<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <!-- reading-buddy hub: receives "what am I reading" from the Chrome extension and
       serves it to Claude Code / Codex over MCP. Bound to 127.0.0.1 only. -->
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@ROOT@/node_modules/tsx/dist/cli.mjs</string>
    <string>src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@ROOT@/hub</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>READING_BUDDY_PORT</key>
    <string>@PORT@</string>
  </dict>

  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>
